generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// â”€â”€â”€ ENUMS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
enum UserStatus {
  active
  disabled
}

enum BookingStatus {
  pending
  confirmed
  ticketed
  cancelled
  failed
  refunded
}

enum PaymentStatus {
  pending
  requires_action
  succeeded
  failed
  cancelled
  refunded
}

enum PaymentMethod {
  card
  bank
  easypaisa
  jazzcash
  sadapay
}

enum PassengerType {
  adult
  child
  infant
}

enum AdminRole {
  super_admin
  operations
  content_manager
}

enum RequestStatus {
  open
  in_progress
  resolved
  closed
}

// â”€â”€â”€ MODELS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?
  name          String
  passwordHash  String
  status        UserStatus @default(active)
  adminRole     AdminRole?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  bookings      Booking[]
  requests      SupportRequest[]
  sessions      Session[]
  auditLogs     AuditLog[]
  searches      Search[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshHash  String
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Search {
  id          String   @id @default(cuid())
  userId      String?
  tripType    String
  origin      String
  destination String
  departDate  DateTime
  returnDate  DateTime?
  passengers  Json
  cabin       String
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
}

model Booking {
  id                String        @id @default(cuid())
  reference         String        @unique
  userId            String?
  pnr               String?
  supplierReference String?
  status            BookingStatus @default(pending)
  currency          String
  total             Decimal       @db.Decimal(12, 2)
  tripType          String
  contact           Json
  passengers        Json
  providerKey       String
  idempotencyKey    String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  user              User?         @relation(fields: [userId], references: [id])
  segments          BookingSegment[]
  payments          Payment[]
  notifications     Notification[]
  requests          SupportRequest[]

  @@index([userId])
  @@index([pnr])
  @@index([status])
}

model BookingSegment {
  id               String   @id @default(cuid())
  bookingId        String
  marketingCarrier String
  flightNumber     String
  origin           String
  destination      String
  departLocal      DateTime
  arriveLocal      DateTime
  durationMin      Int
  stops            Int
  baggage          Json
  fareBasis        String?
  
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  @@index([bookingId])
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String
  method        PaymentMethod
  gatewayRef    String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String
  status        PaymentStatus @default(pending)
  walletMsisdn  String?
  meta          Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  webhookEvents PaymentWebhookEvent[]
  
  @@index([bookingId])
  @@index([status])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  paymentId   String?
  provider    String
  eventId     String   @unique
  payload     Json
  processedAt DateTime?
  createdAt   DateTime @default(now())
  
  payment     Payment? @relation(fields: [paymentId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  bookingId String?
  type      String
  channel   String
  status    String
  sentAt    DateTime?
  createdAt DateTime @default(now())
  
  booking   Booking? @relation(fields: [bookingId], references: [id])
  
  @@index([bookingId])
}

model SupportRequest {
  id          String        @id @default(cuid())
  caseId      String        @unique
  userId      String
  bookingId   String?
  subject     String
  category    String
  description String
  status      RequestStatus @default(open)
  lastUpdate  DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id])
  booking     Booking?      @relation(fields: [bookingId], references: [id])
  messages    SupportMessage[]
  attachments Attachment[]
  
  @@index([userId])
  @@index([status])
}

model SupportMessage {
  id         String   @id @default(cuid())
  requestId  String
  authorId   String?
  authorRole String
  body       String
  createdAt  DateTime @default(now())
  
  request    SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String   @id @default(cuid())
  requestId String?
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())
  
  request   SupportRequest? @relation(fields: [requestId], references: [id])
}

model CmsPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String
  metaTitle       String?
  metaDescription String?
  status          String   @default("published")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  meta      Json?
  createdAt DateTime @default(now())
  
  user      User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([entity, entityId])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String?
  title     String?
  createdAt DateTime @default(now())
  messages  AiMessage[]
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())
  
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

